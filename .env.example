# Copy sang .env roi sua. Dung cho docker-compose.yml.
#   cp .env.example .env

# ---- Postgres cua Immich ---------------------------------------------------
# Dung chung database voi Immich, nhung ghi vao bang rieng prefix fp_.
# Bang cua Immich chi doc, khong bao gio bi ghi.
#
# host.docker.internal = Postgres dang listen tren host may.
# Neu Immich chay cung mot Docker network thi dat ten container cua no
# (thuong la 'immich_postgres') va bo extra_hosts trong compose di.
PG_HOST=host.docker.internal
PG_PORT=5432
PG_DATABASE=immich
PG_USER=postgres
PG_PASSWORD=
PG_SCHEMA=public
TABLE_PREFIX=fp_

# ---- Nguon anh: chon MOT trong hai cach -----------------------------------
# Cach 1 (nhanh hon nhieu, khuyen dung): mount thu muc upload cua Immich.
# UPLOAD_LOCATION tro vao dung thu muc UPLOAD_LOCATION trong .env cua Immich.
# Compose mount no read-only vao /immich-upload.
UPLOAD_LOCATION=/duong/dan/den/immich/upload
MEDIA_ROOT=/immich-upload

# Cach 2: doc qua Immich API, khi khong mount duoc volume.
# De MEDIA_ROOT TRONG roi dien hai dong duoi, va de UPLOAD_LOCATION=/tmp
# (compose van mount nhung khong dung den — xem ghi chu trong docker-compose.yml).
# Cham hon va tao tai cho Immich, vi moi stage phai tai lai toan bo anh mot luot.
# UPLOAD_LOCATION=/tmp
# MEDIA_ROOT=
# IMMICH_URL=http://host.docker.internal:2283
# IMMICH_API_KEY=

# ---- Web UI ---------------------------------------------------------------
TIMELINE_PORT=8080

# Service nay xem duoc TOAN BO anh trong thu vien. De trong = khong xac thuc.
# Sinh token:  python -c "import secrets;print(secrets.token_urlsafe(32))"
# Truy cap: http://localhost:8080/?token=...
API_TOKEN=

# ---- Tai nguyen -----------------------------------------------------------
# Mac dinh nham vao may yeu (4 core, 8GB) dung chung voi Immich.
ONNX_THREADS=2
SLEEP_MS=40
MAX_SIDE=1600
BATCH_COMMIT=200
FFMPEG_THREADS=2
MAX_FRAMES=1200
INDEXER_CPUS=2
INDEXER_MEMORY=2g

# ---- Phien ban image ------------------------------------------------------
# latest, hoac sha-<commit> de ghim mot ban cu the.
TAG=latest
