# Copy sang .env (chay local) hoac chuyen thanh ConfigMap/Secret (k3s).

# ---- Postgres cua Immich: dung chung user/pass/db, chi khac prefix bang ----
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=immich
PG_USER=postgres
PG_PASSWORD=
PG_SCHEMA=public
TABLE_PREFIX=fp_

# ---- Nguon anh: uu tien doc file, khong tao tai cho Immich ----
# Tro vao UPLOAD_LOCATION cua Immich, mount read-only.
MEDIA_ROOT=/immich-upload
# Chi can khi khong mount duoc volume:
# IMMICH_URL=http://immich-server:2283
# IMMICH_API_KEY=

# ---- Model ----
MODEL_DIR=/models
FACE_MODEL=buffalo_l
BODY_MODEL=yolov8n-pose.onnx
BODY_IMGSZ=640
BODY_CONF=0.35
BODY_IOU=0.55
BODY_MAX_PERSON=12
USE_GPU=0

# ---- Tai nguyen: may 8GB RAM / i5, dung chung node voi Immich ----
ONNX_THREADS=2
BATCH_COMMIT=200
MAX_SIDE=1600
# Nghi giua moi anh de nhuong CPU cho Immich. 0 = chay het toc do.
SLEEP_MS=0
# Gioi han so anh moi lan chay, 0 = khong gioi han. Huu ich khi chay thu.
LIMIT=0
COPY_EMBEDDING=1

# ---- Pham vi scan (de trong = toan bo) ----
# TAKEN_AFTER=2010-01-01
# TAKEN_BEFORE=2026-12-31
