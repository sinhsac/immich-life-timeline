# Copy sang .env (chay local) hoac chuyen thanh ConfigMap/Secret (k3s).

# ---- Postgres cua Immich: dung chung user/pass/db, chi khac prefix bang ----
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=immich
PG_USER=postgres
PG_PASSWORD=
PG_SCHEMA=public
TABLE_PREFIX=fp_

# ---- Nguon anh: uu tien doc file, khong tao tai cho Immich ----
# Tro vao UPLOAD_LOCATION cua Immich, mount read-only.
MEDIA_ROOT=/immich-upload
# Chi can khi khong mount duoc volume:
# IMMICH_URL=http://immich-server:2283
# IMMICH_API_KEY=

# ---- Model ----
MODEL_DIR=/models
FACE_MODEL=buffalo_l
BODY_MODEL=yolov8n-pose.onnx
BODY_IMGSZ=640
BODY_CONF=0.35
BODY_IOU=0.55
BODY_MAX_PERSON=12
USE_GPU=0

# ---- Tai nguyen: may 8GB RAM / i5, dung chung node voi Immich ----
ONNX_THREADS=2
BATCH_COMMIT=200
MAX_SIDE=1600
# Nghi giua moi anh de nhuong CPU cho Immich. 0 = chay het toc do.
SLEEP_MS=0
# Gioi han so anh moi lan chay, 0 = khong gioi han. Huu ich khi chay thu.
LIMIT=0
COPY_EMBEDDING=1

# ---- Video (stage clips) ----
# Immich chi detect mat cho video tren MOT frame thumbnail, nen muon cat "doan
# dep nhat co ong A" thi phai tu quet. Day la stage dat nhat, va la stage duy
# nhat chay detection + recognition. Hai model can dung DA nam trong buffalo_l.
# Bat buoc phai co MEDIA_ROOT (doc file video truc tiep).
DO_VIDEO=1
# So frame lay mau moi giay. 2 la du de tim doan; 0 = LAY TAT CA frame (rat cham,
# chi dung khi muon chinh xac tung frame). Tang len 4-5 neu video hay lac.
VIDEO_FPS=2
# Ha frame xuong truoc khi infer. Toa do luu chuan hoa 0..1 nen khong sai lech.
VIDEO_MAX_SIDE=960
# Chi quet N giay dau moi video, 0 = ca video.
VIDEO_MAX_SECONDS=0
VIDEO_DET_SIZE=512
VIDEO_DET_CONF=0.45
# Cosine toi thieu voi vector trung tam cua mot person trong fp_face, VA phai
# cach person xep thu hai it nhat VIDEO_MARGIN. Hai dieu kien, khong phai mot:
# nguoi than co net giong nhau dat 0.43-0.45 tren thu vien that.
VIDEO_SIM=0.38
VIDEO_MARGIN=0.04
VIDEO_CENTROID_PER=24

# ---- Do day cua du lieu video ----
# Giu ca mat KHONG khop person nao (person_id NULL). Bat la mac dinh: nguoi chua
# gan ten trong Immich, hoac nguoi hoan toan moi, van de lai vector + track de
# sau nay gom cum va phat hien "day la mot person moi". Tat di thi bang gon hon
# nhung tu bo kha nang do.
VIDEO_KEEP_UNMATCHED=1
# Luu vector ArcFace (2KB/dong). O muc 2 frame/s la khoang 0.5-1MB moi phut
# video, doi lay viec gan ten lai bang 'job.py --stage rematch' thay vi quet lai.
VIDEO_STORE_EMB=1
# Chay 1k3d68 cho tung mat -> lmk68 + pitch that + age + ear, ngang voi anh tinh.
# Khong co lmk68 thi frame video khong align duoc khi render. Doi lai: them mot
# lan infer moi mat moi frame, trong stage dat nhat.
VIDEO_LMK68=1
# Body pose tren CUNG frame do -> fp_vbody (doi xung voi fp_body cua anh).
DO_VBODY=1
# Bo qua mat nho hon nguong nay (khoang cach hai mat, pixel tren frame da resize).
# 0 = giu tat ca. Day la van dieu chinh chinh khi bang phinh: canh dong nguoi cho
# ra vai chuc mat 10px moi frame, vo dung ma chiem phan lon so dong.
VIDEO_MIN_FACE_PX=0
# IoU toi thieu de coi hai bbox o hai frame lien tiep la cung mot nguoi (track).
VIDEO_TRACK_IOU=0.30

# Mat hut bao lau ma van tinh la nguoi do con trong khung
VIDEO_GAP_MS=800
# Do dai doan nham tren / toi thieu / toi da, va so doan giu lai moi nguoi
CLIP_SECONDS=2.6
CLIP_MIN_SECONDS=1.2
CLIP_MAX_SECONDS=4.5
CLIP_PER_PERSON=3

# ---- Pham vi scan (de trong = toan bo) ----
# (xem them 'job.py --stage smiles' de dien diem nu cuoi cho db da co lmk68)
# TAKEN_AFTER=2010-01-01
# TAKEN_BEFORE=2026-12-31
