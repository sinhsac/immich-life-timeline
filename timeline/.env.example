# Copy sang .env (chay local) hoac chuyen thanh ConfigMap/Secret (k3s).

# ---- Postgres: cung db voi Immich va voi job indexer ----
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=immich
PG_USER=postgres
PG_PASSWORD=
PG_SCHEMA=public
TABLE_PREFIX=fp_
PG_POOL_MAX=4

# ---- Anh: chon MOT trong hai duong ----
# 1. Doc thang volume cua Immich (nhanh nhat, khong tao tai cho Immich):
MEDIA_ROOT=/immich-upload
# 2. Hoac tai qua API khi khong mount duoc volume (de trong MEDIA_ROOT):
# IMMICH_URL=http://127.0.0.1:2283
# IMMICH_API_KEY=
# HTTP_TIMEOUT=30

# ---- Thu muc ghi: cache thumbnail + frame + video (can PVC) ----
WORK_DIR=/work

# ---- Nhac nen (tuy chon) ----
# Thu muc chua nhac. De trong = tat han tinh nang nhac.
#
# Vi sao nen co: anh tinh khong co tieng, doan video thi co. Hai doan video cach
# nhau boi bon buc anh la nam giay im lang roi tieng ap vao. Nhac giu mach am
# lien tuc; khi doan video co tieng that thi nhac tu ha xuong (ducking).
#
# Ten bai gui len khi render la duong dan TUONG DOI trong thu muc nay, vd
# {"music": "cham/piano-01.mp3"}. UI o buoc 4 co o tim kiem, nghe thu, va nut
# chon ngau nhien; thu muc con duoc dung lam bo loc.
# MUSIC_DIR=/music
#
# Mount READ-ONLY neu chi doc. Muon upload tu UI thi phai mount ghi duoc, va thu
# muc phai thuoc dung uid ma container chay (mac dinh 10001 trong image, 1000
# trong manifest k3s mau) — fsGroup KHONG ap dung cho hostPath.
#
# CA MOT KHO NHAC thi upload qua trinh duyet la sai cong cu: mount read-only thu
# muc co san, hoac rsync mot lan. Nut upload danh cho 'tim duoc mot bai, thu xem'.
#
# Ba tran cho duong ghi. Cai thu ba moi la cai quan trong: hai tran dau khong biet
# gi ve viec dia con bao nhieu, ma MUSIC_DIR thuong nam cung phan vung voi
# container runtime — lam day dia khong lam 'upload that bai', no lam ca node
# ngung hoat dong.
# MUSIC_MAX_MB=30
# MUSIC_MAX_TOTAL_MB=6000
# MUSIC_MIN_FREE_MB=3000
#
# Cat canh dung phach nhac: gui {"beat_sync": true} khi render, hoac bat o buoc 4.
# Chi hoat dong khi da chon nhac. BPM chi do KHI BAN CHON mot bai, khong do ca
# danh sach: mot lan do la giai ma 120 giay + FFT (~1-3 giay), nen ca nghin bai
# se la 20-50 phut CPU. Bo do nhip dung numpy + ffmpeg san co; muon chinh xac hon
# voi nhac doi tempo giua bai thi `pip install librosa`, code tu dong dung neu co.

# ---- ffmpeg ----
FFMPEG=ffmpeg
# ffprobe di kem ffmpeg. Dung de biet doan video co track tieng khong — mot input
# khong co audio se lam ca filter_complex ghep tieng that bai.
FFPROBE=ffprobe
FFMPEG_THREADS=2

# ---- Font ve nhan chuong / ten nguoi (co dau tieng Viet) ----
# De trong thi tu tim DejaVu / Liberation / FreeSans trong he thong. Image da cai
# fonts-dejavu-core nen khong phai dat gi. Khong tim thay font nao thi chu bi bo
# dau, video van ra binh thuong.
# FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# ---- Bao mat ----
# Service nay xem duoc toan bo anh gia dinh. Dat token truoc khi mo cong.
# Sinh: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_TOKEN=

# ---- Gioi han ----
MAX_FRAMES=1200
THUMB_SIZE=160
