# Copy sang .env (chay local) hoac chuyen thanh ConfigMap/Secret (k3s).

# ---- Postgres: cung db voi Immich va voi job indexer ----
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=immich
PG_USER=postgres
PG_PASSWORD=
PG_SCHEMA=public
TABLE_PREFIX=fp_
PG_POOL_MAX=4

# ---- Anh: chon MOT trong hai duong ----
# 1. Doc thang volume cua Immich (nhanh nhat, khong tao tai cho Immich):
MEDIA_ROOT=/immich-upload
# 2. Hoac tai qua API khi khong mount duoc volume (de trong MEDIA_ROOT):
# IMMICH_URL=http://127.0.0.1:2283
# IMMICH_API_KEY=
# HTTP_TIMEOUT=30

# ---- Thu muc ghi: cache thumbnail + frame + video (can PVC) ----
WORK_DIR=/work

# ---- Nhac nen (tuy chon, mount read-only) ----
# Thu muc chua san vai ban nhac. De trong = tat han tinh nang nhac.
#
# Vi sao nen co: anh tinh khong co tieng, doan video thi co. Hai doan video cach
# nhau boi bon buc anh la nam giay im lang roi tieng ap vao. Nhac giu mach am
# lien tuc; khi doan video co tieng that thi nhac tu ha xuong (ducking).
#
# Ten bai gui len khi render la duong dan TUONG DOI trong thu muc nay, vd
# {"music": "cham/piano-01.mp3"}. GET /api/music de liet ke.
# MUSIC_DIR=/music
#
# Cat canh dung phach nhac: gui {"beat_sync": true} khi render. Chi hoat dong khi
# da chon nhac. Bo do nhip dung numpy + ffmpeg san co; muon chinh xac hon voi nhac
# doi tempo giua bai thi `pip install librosa`, code tu dong dung neu co.

# ---- ffmpeg ----
FFMPEG=ffmpeg
# ffprobe di kem ffmpeg. Dung de biet doan video co track tieng khong — mot input
# khong co audio se lam ca filter_complex ghep tieng that bai.
FFPROBE=ffprobe
FFMPEG_THREADS=2

# ---- Font ve nhan chuong / ten nguoi (co dau tieng Viet) ----
# De trong thi tu tim DejaVu / Liberation / FreeSans trong he thong. Image da cai
# fonts-dejavu-core nen khong phai dat gi. Khong tim thay font nao thi chu bi bo
# dau, video van ra binh thuong.
# FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# ---- Bao mat ----
# Service nay xem duoc toan bo anh gia dinh. Dat token truoc khi mo cong.
# Sinh: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_TOKEN=

# ---- Gioi han ----
MAX_FRAMES=1200
THUMB_SIZE=160
